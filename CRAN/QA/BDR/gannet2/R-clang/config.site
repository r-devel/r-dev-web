CL23=/usr/local/clang23

CC=$CL23/bin/clang-23
CXX=$CL23/bin/clang++
OBJC=$CC
FC=$CL23/bin/flang-23
CFLAGS="-O3 -Wall -pedantic -Wp,-D_FORTIFY_SOURCE=3"
C17FLAGS="-O3 -Wall -pedantic -Wno-strict-prototypes -Wp,-D_FORTIFY_SOURCE=3"
FFLAGS="-O2 -pedantic"
CXXFLAGS="-O3 -Wall -pedantic -frtti -Wp,-D_FORTIFY_SOURCE=3 -Wno-missing-template-arg-list-after-template-kw -D_LIBCPP_KEEP_TRANSITIVE_INCLUDES_LLVM23"
CPPFLAGS="-isystem $CL23/include -I/usr/local/clang/include"
JAVA_HOME=/usr/lib/jvm/java-25

LDFLAGS="-L/usr/local/clang/lib64 -L$CL23/lib -L$CL23/lib/x86_64-unknown-linux-gnu -L/usr/local/lib64"

