#!/bin/sh
MAIL=/bin/mail
RECIP="CRAN@R-project.org"
TMPFILE=/tmp/R-logs.$$

LC_COLLATE=C /usr/local/bin/Rscript ~/R/packages/check_diffs.R > $TMPFILE
cp -p ~/Rlogs/gcc-check.csv ~/Rlogs/gcc-check.csv.prev
cp -p ~/Rlogs/clang-check.csv ~/Rlogs/clang-check.csv.prev

cat $TMPFILE | $MAIL -s "[Rcheck] gannet2 on `date -Idate`" $RECIP
rm -f $TMPFILE
